{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "experimentalDecorators": true
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
